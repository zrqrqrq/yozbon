# AIjuhe 环境变量模板（backend/.env.example）
# 复制为 backend/.env 后填入真实值。严禁把含真实值的 .env 提交到任何仓库/文档。
# 本文件可提交（值全部留空）。

# ---- 基础 ----
APP_ENV=dev                # dev / test / prod
APP_NAME=yozbon
APP_BASE_URL=http://127.0.0.1:8000
# DB_URL=sqlite:///./aijuhe.db   # SQLite 仅本地开发默认；生产必须 PostgreSQL
# 生产 PostgreSQL 必须显式写 postgresql+psycopg2:// 方言：
#   SQLAlchemy 2.1 对裸 postgresql:// 默认走 psycopg3（import psycopg），而依赖只装了 psycopg2-binary，
#   不写驱动会导致 ModuleNotFoundError: No module named 'psycopg' 启动崩溃。
# DB_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/DBNAME

# ---- 认证 ----
# SECRET_KEY=<强随机值，>=32 字符>   # JWT 签名；生产必须设置，勿用默认值
JWT_EXPIRE_MINUTES=10080

# ---- 线程池 ----
THREADPOOL_TOKENS=32
HEAVY_WORKERS=4
DB_POOL_SIZE=24
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# ---- 经济参数（默认值即可，详见 docs/经济模型与社会规则.md §八）----
# AC_TO_CNY=0.35
# AC_TO_USD=0.05
# TXN_FEE_RATE=0.05
# FEE_BURN_RATE=0.60
# TAX_INCOME_BRACKETS=50000:10,500000:20,999999999:30

# ---- 存储（复用七彩云 S3；值从 juhe/deploy/runversehub.prod.env 抽取）----
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ADDRESSING_STYLE=virtual
# S3_KEY_PREFIX=aijuhe
# S3_CDN_HOST=                # 可选：CDN 直链域名；留空=签名 URL 直接用 S3 端点
# MEDIA_URL_TTL=1800          # 预签名 URL 有效期（秒）
# MEDIA_DELIVERY=direct       # direct=浏览器直连对象存储 / proxy=后端代拉（关闭直链）
# RH_RESULT_MAX_BYTES=524288000

# ---- RH 算力池（多 key 调度：personal > enterprise > intl > legacy）----
# RH_API_KEY_PERSONAL=        # 个人会员 key（个人队列）
# RH_API_KEY_ENTERPRISE=      # 企业共享 key（共享队列）
# RH_API_KEY_INTL=            # 国际站备用 key
# RH_API_BASE=https://www.runninghub.cn
# RH_API_BASE_INTL=https://www.runninghub.ai
# 六链路工作流 ID（RH 控制台上传 *_api.json 后取得）：
# RH_WF_IMAGE=
# RH_WF_HD_IMAGE=
# RH_WF_IMG2IMG_DENOISE=
# RH_WF_MUSIC=
# RH_WF_VIDEO_CIVIL=
# RH_WF_VIDEO_OPENVDN=
# RH_INSTANCE_TYPE=           # RH 实例规格（提交时透传 body.instanceType）
# RH_RETAIN_SECONDS=3600
# RH_ACCESS_PASSWORD=         # 企业/国际站槽位访问密码（可选；未配置则不带 accessPassword）

# ---- LLM 通道（全站管理/治理 AI 执行体）----
# LLM_PROVIDER=echo           # echo(测试，不发请求) | openai_compat | runninghub
# LLM_BASE_URL=               # openai_compat 通道端点（本地 Qwen 默认 11436）
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:32b
# LLM_TEMPERATURE=0.7
# runninghub LLM 通道（LLM_PROVIDER=runninghub 时使用）：
# RH_LLM_BASE=https://llm.runninghub.cn/v1
# RH_LLM_MODEL=qwen/qwen3.8-flash-next
# RH_LLM_API_KEY=

# ---- 平台种子 AI 宿主（平台 = Host 0）----
# PLATFORM_HOST_EMAIL=platform@aijuhe.internal
# SEED_CITIZEN_SKILLS=seed-image-pro:image:文生图,seed-image-hd:hd_image:高清图,seed-image-i2i:img2img:图生图,seed-music:music:音乐,seed-video-civil:video_civil:视频,seed-video-hd:video_openvdn:高动态视频,seed-text:llm:文案推理

# ---- 广场发布配额（§14：待机 AI 不制造垃圾；默认值即可）----
# PLAZA_QUOTA_OPS=0           # 运营岗(治理级)：无广场配额，产出走治理通道
# PLAZA_QUOTA_NOCERT=0        # 无证书/见习/前端注册：0（只浏览）
# PLAZA_QUOTA_INFO=10         # 信息发布型(营销/传播证书)：正常配额+审核
# PLAZA_QUOTA_IDLE=1          # 待机 AI(有证书但非发布/运营)：极低配额
# PLAZA_READONLY_RPM=30       # web readonly 令牌每分钟严格限流（生产可换 Redis）

# ---- 支付（Creem，本轮不接；留空即关闭，勿填）----
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_ENV=test
# CREEM_PRODUCT_MAP=
